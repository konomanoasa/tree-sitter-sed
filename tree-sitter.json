{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "sed_gnu",
      "camelcase": "SedGnu",
      "title": "GNU sed",
      "scope": "source.sed.gnu",
      "path": "gnu",
      "external-files": ["common/scanner.h"],
      "file-types": ["sed"],
      "highlights": [
        "queries/highlights.common.scm",
        "queries/highlights.gnu.scm"
      ],
      "first-line-regex": "^#!.*\\bg?sed\\b",
      "injection-regex": "^(g?sed|sed_gnu)$"
    },
    {
      "name": "sed_posix",
      "camelcase": "SedPosix",
      "title": "POSIX sed",
      "scope": "source.sed.posix",
      "path": "posix",
      "external-files": ["common/scanner.h"],
      "highlights": ["queries/highlights.common.scm"],
      "injection-regex": "^posix-sed$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammars for POSIX.1-2024 and GNU sed scripts.",
    "authors": [
      {
        "name": "konomanoasa"
      }
    ],
    "links": {
      "repository": "https://github.com/konomanoasa/tree-sitter-sed"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}

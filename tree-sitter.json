{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "sed",
      "title": "GNU sed",
      "scope": "source.sed",
      "path": ".",
      "file-types": ["sed"],
      "injection-regex": "^sed$",
      "highlights": "queries/highlights.scm",
      "external-files": ["common/scanner.h", "common/tokens.h"]
    },
    {
      "name": "sed_ere",
      "title": "GNU sed (ERE)",
      "scope": "source.sed.ere",
      "path": "sed_ere",
      "injection-regex": "^sed_ere$",
      "highlights": "queries/highlights.scm",
      "external-files": ["common/scanner.h", "common/tokens.h"]
    }
  ],
  "metadata": {
    "version": "0.21.0",
    "license": "MIT",
    "description": "Tree-sitter grammars for GNU sed 4.10.",
    "links": {
      "repository": "https://github.com/konomanoasa/tree-sitter-sed"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false
  }
}

{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "sed",
      "camelcase": "Sed",
      "title": "POSIX sed (BRE)",
      "scope": "source.sed",
      "path": "sed",
      "external-files": ["common/scanner.h"]
    },
    {
      "name": "sed_ere",
      "camelcase": "SedEre",
      "title": "POSIX sed (ERE)",
      "scope": "source.sed.ere",
      "path": "sed-ere",
      "external-files": ["common/scanner.h"]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammars for POSIX sed.",
    "authors": [
      {
        "name": "konomanoasa"
      }
    ],
    "links": {
      "repository": "https://github.com/konomanoasa/tree-sitter-sed"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}

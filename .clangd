CompileFlags:
  Add:
    - -std=c17
    - -xc
    - -Wall
    - -Wextra
    - -Werror
    - -pedantic

---
If:
  PathMatch: .*\.h
CompileFlags:
  Add:
    - -xc-header

---
If:
  PathMatch:
    - common/scanner\.h
    - test/scanner\.test\.c
CompileFlags:
  Add:
    - -DSED_EXTENDED=0

---
If:
  PathMatch: bindings/python/.*\.c
CompileFlags:
  CompilationDatabase: None
  Add:
    - -I../../src

CompileFlags:
  Add:
    - -std=c17
    - -xc
    - -Wall
    - -Wextra
    - -Werror
    - -pedantic
    - -Wno-unused-function

---
If:
  PathMatch: .*\.h
CompileFlags:
  Add:
    - -xc-header

---
If:
  PathMatch:
    - src/.*
    - sed_ere/src/.*
CompileFlags:
  Add:
    - -I.

---
If:
  PathMatch:
    - common/scanner\.h
    - test/scanner\.test\.c
CompileFlags:
  Add:
    - -DSED_REGEX_EXTENDED=0
    - -I../src

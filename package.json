{
  "name": "tree-sitter-sed",
  "version": "0.1.0",
  "private": true,
  "description": "Tree-sitter BRE and ERE grammars for POSIX.1-2024 and GNU sed scripts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konomanoasa/tree-sitter-sed.git"
  },
  "bugs": {
    "url": "https://github.com/konomanoasa/tree-sitter-sed/issues"
  },
  "homepage": "https://github.com/konomanoasa/tree-sitter-sed#readme",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "cli": "node scripts/run-tree-sitter.js",
    "generate": "node scripts/generate-parsers.js",
    "format": "biome format --write .",
    "check:biome": "biome check .",
    "check:generated": "node scripts/check-generated.js",
    "test": "npm run test:corpus && npm run test:wasm && npm run test:integrations",
    "test:corpus": "node scripts/run-tree-sitter.js test",
    "test:integrations": "node scripts/check-language-integrations.js",
    "test:wasm": "node scripts/run-wasm-tests.js",
    "test:debug": "node scripts/run-tree-sitter.js test --debug-build --rebuild",
    "test:fuzz": "node scripts/run-fuzz-tests.js --iterations 100 --edits 5",
    "check": "npm run check:biome && npm run check:generated && npm test"
  },
  "keywords": [
    "tree-sitter",
    "sed",
    "bre",
    "ere",
    "posix",
    "gnu",
    "gnu-sed"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "tree-sitter-cli": "0.26.11",
    "web-tree-sitter": "0.26.11"
  },
  "allowScripts": {
    "tree-sitter-cli": true
  }
}

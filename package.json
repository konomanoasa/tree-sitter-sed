{
  "name": "tree-sitter-sed",
  "version": "0.22.2",
  "description": "Tree-sitter grammars for GNU sed 4.10.",
  "license": "MIT",
  "repository": "git+https://github.com/konomanoasa/tree-sitter-sed.git",
  "type": "module",
  "files": [
    "Cargo.toml",
    "bindings/python/*.c",
    "bindings/python/*.py",
    "bindings/python/*.pyi",
    "bindings/python/py.typed",
    "bindings/rust/*.rs",
    "common/**/*.h",
    "common/**/*.js",
    "grammar.js",
    "pyproject.toml",
    "queries/*.scm",
    "sed_ere/grammar.js",
    "sed_ere/src/*.c",
    "sed_ere/src/*.json",
    "sed_ere/src/tree_sitter/*.h",
    "setup.py",
    "src/*.c",
    "src/*.json",
    "src/tree_sitter/*.h",
    "test/bindings.test.rs",
    "tree-sitter.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run tree-sitter -- build-all",
    "check": "biome check . && tsc",
    "check:queries": "npm run tree-sitter -- check-queries",
    "format": "biome format --write .",
    "generate": "npm run tree-sitter -- generate-all",
    "test": "npm run tree-sitter -- test-corpus --rebuild && node --test --test-concurrency=1 test/build.test.js test/cst.test.js test/highlight.test.js test/incremental.test.js test/parser.test.js && node scripts/check-c.js --test",
    "test:fuzz": "npm run tree-sitter -- fuzz-all --iterations 100 --edits 5",
    "test:sanitize": "node scripts/check-c.js --sanitize",
    "tree-sitter": "node scripts/tree-sitter.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "26.6.5",
    "tree-sitter-cli": "0.27.1",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "tree-sitter-cli": true
  }
}
